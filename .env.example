# OCR_PROVIDER can be "tesseract" or "mock".
OCR_PROVIDER=tesseract

# Default OCR language. Tesseract language packs use short codes such as:
# eng, ben, hin, ara, fra, deu, spa
OCR_DEFAULT_LANGUAGE=eng

# Optional. Leave OCR_LANG_PATH blank to let Tesseract.js use its default CDN.
# Set OCR_CACHE_PATH to a writable folder to reuse downloaded language data.
OCR_LANG_PATH=
OCR_CACHE_PATH=.ocr-cache
OCR_DEBUG=false

# Reserved for future hosted OCR providers such as Google Vision, Azure AI Vision,
# Mathpix, or a multimodal LLM endpoint.
OCR_API_KEY=
